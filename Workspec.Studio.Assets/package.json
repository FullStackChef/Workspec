{
  "name": "workspec.studio.assets",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run build:js && npm run build:css",
    "watch": "concurrently \"npm:watch:js\" \"npm:watch:css\"",
    "build:css": "sass styles/app.scss ../Workspec.Studio/wwwroot/css/app.css",
    "watch:css": "sass --watch styles/app.scss:../Workspec.Studio/wwwroot/css/app.css",
    "build:js": "esbuild index.ts --bundle --format=esm --minify --sourcemap --outfile=../Workspec.Studio/wwwroot/js/workspec.studio-interop.js",
    "watch:js": "esbuild index.ts --bundle --format=esm --sourcemap --watch --outfile=../Workspec.Studio/wwwroot/js/workspec.studio-interop.js",
    "clean": "tsc --build --clean"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "esbuild": "0.25.1",
    "eslint": "^9.22.0",
    "sass": "^1.86.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@joint/core": "^4.1.3",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0"
  }
}
