@inject NavigationManager Navigation
@inject MenuBuilderService MenuService

<SfAppBar ColorMode="AppBarColor.Dark">
    <img src="/assets/images/workspec-logo.png" alt="Workspec Logo" class="h-full" />
    <AppBarSpacer />
    <div class="w-3rem">
        <SfTextBox @ref="SearchTxtbox"
                   Placeholder="Search..."
                   Autocomplete="AutoComplete.Off" 
                   CssClass="e-dark"
                   Created="@(AddSearchIcon)" />
    </div>
</SfAppBar>
<SfToolbar>
    <ToolbarItems>
        <ToolbarItem>
            <Template>
                <MenuBar />
            </Template>
        </ToolbarItem>
        <ToolbarItem Align="ItemAlign.Right">
            <Template>
                <!-- Right: Search + Icons + User -->
                <div class="flex items-center gap-4">
                    <SfButton IconCss="ri-question-fill" CssClass="e-flat" />
                    <SfButton IconCss="ri-inbox-fill" CssClass="e-flat" />
                    <SfButton IconCss="ri-notification-4-fill" CssClass="e-flat" />
                    <SfDropDownButton CssClass="e-outline" Content="@Username" Items="@UserMenuItems" IconCss="ri-account-circle-fill" />
                </div>
            </Template>
        </ToolbarItem>
    </ToolbarItems>
</SfToolbar>
@code {
    private SfTextBox? SearchTxtbox;
    private List<MenuItem> TopMenuItems = new();
    private string Username => "Brett Smith";

    private List<DropDownMenuItem> UserMenuItems = new()
    {
        new() { Text = "Profile" },
        new() { Text = "Settings" },
        new() { Separator = true },
        new() { Text = "Sign Out", Url = "/authentication/logout" }
    };
    private async Task AddSearchIcon()
    {
        if (SearchTxtbox is SfTextBox)
        {
            await SearchTxtbox.AddIconAsync("append", "e-icons e-search");
        }
    }
    protected override void OnInitialized()
    {
        var area = Navigation.ToBaseRelativePath(Navigation.Uri).Split("/").FirstOrDefault() ?? "home";
        TopMenuItems = MenuService.GetAreaMenu(area);
    }
}
